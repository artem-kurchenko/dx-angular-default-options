{
  "name": "dx-angular-level-solutions",
  "version": "1.0.0",
  "description": "Two Angular-level ways to share DevExtreme configuration without loading widget code at startup.",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "prestart": "devextreme-license --out src/devextreme-license.ts --force",
    "start": "ng serve",
    "prebuild": "devextreme-license --out src/devextreme-license.ts --force",
    "build": "ng build",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
    "@angular/platform-browser": "^22.0.2",
    "@angular/router": "^22.0.2",
    "devextreme": "26.1.3",
    "devextreme-angular": "26.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "~22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "typescript": "~6.0.3"
  }
}
